# Created by Ansible
# The server list comes from the dynamic inventory (group "monitoring").
# "each vmagent scrapes both servers" (green dashed arrow in the diagram)
# so the VictoriaMetrics on each server has the COMPLETE data.
global:
  scrape_interval: {{ scrape_interval }}

scrape_configs:
  - job_name: node
    static_configs:
{% for host in groups['monitoring'] %}
      - targets: ["{{ hostvars[host].private_ip_address }}:9100"]
        labels:
          server: {{ host }}
{% endfor %}
