//
// Jenkins credentials needed:
//
//   aws-monitoring-demo
//     Type: AWS Credentials
//     Used by Terraform and Ansible
//
//   monitoring-ssh-key
//     Type: SSH Username with private key
//     Username: ubuntu
//     Private key: grafana-vm-demo-key.pem
// ------------------------------------------------------------

pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'apply = create/configure everything, destroy = delete everything'
        )
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        ANSIBLE_CONFIG     = "${WORKSPACE}/ansible/ansible.cfg"
        TF_IN_AUTOMATION   = 'true'
        PATH               = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    }

    options {
        disableConcurrentBuilds()
    }

    stages {

        // ----------------------------------------------------
        // 1. Dependencies
        // ----------------------------------------------------
        stage('Dependencies') {
            steps {
                sh '''
                    echo "== Tools on this Jenkins machine =="
                    terraform -version
                    ansible --version

                    echo "== Ansible AWS collection =="
                    ansible-galaxy collection install -r ansible/requirements.yml

                    echo "== boto3 (required by AWS dynamic inventory) =="
                    PY=$(ansible --version | grep "python version" | awk -F'[()]' '{print $(NF-1)}')

                    echo "Ansible uses Python: $PY"

                    if "$PY" -c "import boto3, botocore" 2>/dev/null; then
                        echo "boto3 already installed"
                    else
                        "$PY" -m pip install --quiet boto3 botocore || \
                        "$PY" -m pip install --quiet --break-system-packages boto3 botocore
                    fi
                '''
            }
        }

        // ----------------------------------------------------
        // 2. Terraform Init
        // ----------------------------------------------------
        stage('Terraform Init') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-monitoring-demo'
                    ]
                ]) {
                    dir('terraform') {
                        sh '''
                            rm -rf .terraform
                            rm -f .terraform/terraform.tfstate
                            terraform init -input=false -reconfigure
                        '''
                    }
                }
            }
        }

        // ----------------------------------------------------
        // 3. Terraform Validate
        // ----------------------------------------------------
        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate'
                }
            }
        }

        // ----------------------------------------------------
        // 4. Terraform Format Check
        // ----------------------------------------------------
        stage('Terraform Fmt') {
            steps {
                dir('terraform') {
                    sh 'terraform fmt -check -recursive -diff'
                }
            }
        }

        // ----------------------------------------------------
        // 5. Terraform Plan
        // ----------------------------------------------------
        stage('Terraform Plan') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-monitoring-demo'
                    ]
                ]) {
                    dir('terraform') {
                        script {
                            if (params.ACTION == 'destroy') {
                                sh 'terraform plan -destroy -input=false -out=tfplan'
                            } else {
                                sh 'terraform plan -input=false -out=tfplan'
                            }
                        }
                    }
                }
            }
        }

        // ----------------------------------------------------
        // 6. Terraform Apply
        // ----------------------------------------------------
        stage('Terraform Apply') {
            when {
                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-monitoring-demo'
                    ]
                ]) {
                    dir('terraform') {
                        sh 'terraform apply -input=false tfplan'
                    }
                }
            }
        }

        // ----------------------------------------------------
        // 7. Ansible Configure Servers
        // ----------------------------------------------------
        stage('Ansible: Configure Servers') {
            when {
                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-monitoring-demo'
                    ],
                    sshUserPrivateKey(
                        credentialsId: 'monitoring-ssh-key',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    dir('ansible') {
                        sh '''
                            echo "== Dynamic inventory: servers found in AWS =="
                            ansible-inventory --graph

                            echo "== Getting bastion public IP from dynamic inventory =="

                            BASTION_IP=$(terraform -chdir=../terraform output -raw bastion_public_ip)
                            echo "Bastion IP discovered dynamically: $BASTION_IP"

                            echo "== Testing SSH to bastion =="

                            ssh -vvv \
                                -i "$SSH_KEY" \
                                -o StrictHostKeyChecking=no \
                                -o UserKnownHostsFile=/dev/null \
                                ubuntu@"$BASTION_IP" "echo BASTION_SSH_OK"

                            echo "== Testing Ansible SSH =="

                            ansible monitoring -m ping \
                                -e "ssh_key_file=$SSH_KEY" \
                                -vvv
                        '''
                    }
                }
            }
        }

        // ----------------------------------------------------
        // 8. Terraform Destroy
        // ----------------------------------------------------
        stage('Terraform Destroy') {
            when {
                expression {
                    params.ACTION == 'destroy'
                }
            }

            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-monitoring-demo'
                    ]
                ]) {
                    dir('terraform') {
                        sh 'terraform apply -input=false tfplan'
                    }
                }
            }
        }
    }

    // --------------------------------------------------------
    // Post-build actions
    // --------------------------------------------------------
    post {

        success {
            script {
                if (params.ACTION == 'apply') {
                    dir('terraform') {
                        sh '''
                            echo "=========================================="
                            echo "Monitoring infrastructure is ready"
                            echo "=========================================="
                            echo "Grafana URL:"
                            terraform output -raw grafana_url
                            echo ""
                            echo "Grafana user: admin"
                            echo "=========================================="
                        '''
                    }
                } else {
                    echo 'Everything has been deleted.'
                }
            }
        }

        failure {
            echo 'Build failed. Open the red stage and read its log.'
        }
    }
}